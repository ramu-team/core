// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ACCOUNT & ACCESS MANAGEMENT
// ==========================================

model User {
  id String @id @default(uuid())

  // For Guest / Lazy Login identification
  guest_session_id String? @unique
  is_guest         Boolean @default(true)

  // Link to Neon Managed Better Auth account (Filled if user logs in via Google)
  neon_auth_user_id String? @unique

  // Shadow data (synced from Neon Auth upon login)
  email      String?
  name       String?
  avatar_url String?

  createdAt DateTime @default(now())

  orders        Order[]
  consultations ConsultationHistory[]
}

model Admin {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  role          String // Example: Superadmin, Operator
  last_login    DateTime?

  activation_codes MachineActivationCode[]
  audit_logs       AuditLog[]
}

// ==========================================
// 2. IOT DEVICE MANAGEMENT
// ==========================================

model Machine {
  id                String  @id @default(uuid())
  registration_code String  @unique // Default hardware code from factory
  is_registered     Boolean @default(false)
  location_name     String?
  status            String  @default("Offline") // Online, Offline
  cups_stock        Int     @default(0)

  activation_codes MachineActivationCode[]
  stocks           MachineStock[]
  orders           Order[]
  consultations    ConsultationHistory[]
}

model MachineActivationCode {
  id              String    @id @default(uuid())
  activation_code String    @unique // Generate by Admin: RAMU-8X2F
  is_used         Boolean   @default(false)
  expires_at      DateTime?

  generated_by_id String
  generated_by    Admin  @relation(fields: [generated_by_id], references: [id])

  used_by_machine_id String?
  used_by_machine    Machine? @relation(fields: [used_by_machine_id], references: [id])
}

// Note: The `pairing_sessions` table is not included in Prisma because the 1-minute QR rotation is handled by Upstash Redis.

// ==========================================
// 3. CATALOG, INGREDIENTS, & MACHINE STOCK
// ==========================================

model Ingredient {
  id         String @id @default(uuid())
  name   String
  unit   String // Example: ml

  recipes Recipe[]
  stocks  MachineStock[]
}

model Menu {
  id           String  @id @default(uuid())
  name         String
  description  String?
  price        Decimal
  image_url    String?
  isActive     Boolean @default(true)

  recipes        Recipe[]
  orders         Order[]
  recommended_in ConsultationHistory[]
}

model Recipe {
  id         String @id @default(uuid())
  amountMl   Float

  menu_id String
  menu    Menu   @relation(fields: [menu_id], references: [id])

  ingredient_id String
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id])
}

model MachineStock {
  id             String @id @default(uuid())
  tankNumber     Int // Pump position on IoT machine
  current_volume Float // Actual remaining liquid volume
  max_capacity   Float

  machine_id String
  machine    Machine @relation(fields: [machine_id], references: [id])

  ingredient_id String
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id])
}

// ==========================================
// 4. AI CONSULTATION & TRANSACTIONS
// ==========================================

model SymptomOption {
  id           String  @id @default(uuid())
  category     String // General Condition, Pain, Digestion
  name         String
  icon         String? // Icon class for Kiosk/Mobile UI
  isActive     Boolean @default(true)
}

model ConsultationHistory {
  id                String   @id @default(uuid())
  selected_symptoms Json? // Store symptom array, e.g.: ["Nausea", "Dizzy"]
  complaintText     String? // Manual chat input from Mobile
  aiCustomRecipe    Json? // New AI recipe format: {"ingredient_id": amount_ml}
  createdAt         DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  machine_id String
  machine    Machine @relation(fields: [machine_id], references: [id])

  recommendedMenuId String?
  rekomendasi_menu    Menu?   @relation(fields: [recommendedMenuId], references: [id])

  Order Order[]
}

model Order {
  id           String   @id @default(uuid()) // order_id that can be used as QRIS reference
  is_custom_ai Boolean  @default(false)
  total_price  Decimal
  status       String   @default("Pending") // Pending, Paid, Brewing, Completed, Failed
  createdAt    DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  machine_id String
  machine    Machine @relation(fields: [machine_id], references: [id])

  menu_id String?
  menu    Menu?   @relation(fields: [menu_id], references: [id])

  consultation_id String?
  consultation    ConsultationHistory? @relation(fields: [consultation_id], references: [id])
}

// ==========================================
// 5. AUDIT & LOGGING
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g., "UPDATE_MACHINE", "CREATE_MENU"
  entity     String   // e.g., "Machine", "Menu"
  entity_id  String?  // UUID of the affected entity
  details    Json?    // Optional detailed changes or payload
  createdAt  DateTime @default(now())

  admin_id   String
  admin      Admin    @relation(fields: [admin_id], references: [id])
}
