// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. MANAJEMEN AKUN & AKSES
// ==========================================

model User {
  id String @id @default(uuid())

  // Untuk identifikasi Guest / Lazy Login
  guest_session_id String? @unique
  is_guest         Boolean @default(true)

  // Link ke akun Neon Managed Better Auth (Terisi jika user login via Google)
  neon_auth_user_id String? @unique

  // Data bayangan (di-sync dari Neon Auth saat login)
  email      String?
  name       String?
  avatar_url String?

  createdAt DateTime @default(now())

  orders        Order[]
  consultations ConsultationHistory[]
}

model Admin {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  role          String // Misal: Superadmin, Operator
  last_login    DateTime?

  activation_codes MachineActivationCode[]
}

// ==========================================
// 2. MANAJEMEN PERANGKAT IOT (DEVICE)
// ==========================================

model Machine {
  id                String  @id @default(uuid())
  registration_code String  @unique // Kode hardware bawaan pabrik
  is_registered     Boolean @default(false)
  location_name     String?
  status            String  @default("Offline") // Online, Offline

  activation_codes MachineActivationCode[]
  stocks           MachineStock[]
  orders           Order[]
  consultations    ConsultationHistory[]
}

model MachineActivationCode {
  id              String    @id @default(uuid())
  activation_code String    @unique // Generate by Admin: RAMU-8X2F
  is_used         Boolean   @default(false)
  expires_at      DateTime?

  generated_by_id String
  generated_by    Admin  @relation(fields: [generated_by_id], references: [id])

  used_by_machine_id String?
  used_by_machine    Machine? @relation(fields: [used_by_machine_id], references: [id])
}

// Catatan: Tabel `pairing_sessions` tidak dimasukkan ke Prisma karena rotasi QR 1 menit ditangani oleh Upstash Redis.

// ==========================================
// 3. KATALOG, BAHAN, & STOK MESIN
// ==========================================

model Ingredient {
  id         String @id @default(uuid())
  name   String
  unit   String // Contoh: ml

  recipes Recipe[]
  stocks  MachineStock[]
}

model Menu {
  id           String  @id @default(uuid())
  name         String
  description  String?
  price        Decimal
  isActive     Boolean @default(true)

  recipes        Recipe[]
  orders         Order[]
  recommended_in ConsultationHistory[]
}

model Recipe {
  id         String @id @default(uuid())
  amountMl   Float

  menu_id String
  menu    Menu   @relation(fields: [menu_id], references: [id])

  ingredient_id String
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id])
}

model MachineStock {
  id             String @id @default(uuid())
  tankNumber     Int // Posisi pompa di mesin IoT
  current_volume Float // Sisa cairan aktual
  max_capacity   Float

  machine_id String
  machine    Machine @relation(fields: [machine_id], references: [id])

  ingredient_id String
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id])
}

// ==========================================
// 4. KONSULTASI AI & TRANSAKSI
// ==========================================

model SymptomOption {
  id           String  @id @default(uuid())
  category     String // Kondisi Umum, Rasa Sakit, Pencernaan
  name         String
  icon         String? // Class ikon untuk UI Kiosk/HP
  isActive     Boolean @default(true)
}

model ConsultationHistory {
  id                String   @id @default(uuid())
  selected_symptoms Json? // Simpan array gejala, cth: ["Mual", "Pusing"]
  complaintText     String? // Input manual chat dari HP
  aiCustomRecipe    Json? // Format resep baru AI: {"ingredient_id": takaran_ml}
  createdAt         DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  machine_id String
  machine    Machine @relation(fields: [machine_id], references: [id])

  recommendedMenuId String?
  rekomendasi_menu    Menu?   @relation(fields: [recommendedMenuId], references: [id])

  Order Order[]
}

model Order {
  id           String   @id @default(uuid()) // order_id yang bisa jadi referensi QRIS
  is_custom_ai Boolean  @default(false)
  total_price  Decimal
  status       String   @default("Pending") // Pending, Paid, Brewing, Completed, Failed
  createdAt    DateTime @default(now())

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  machine_id String
  machine    Machine @relation(fields: [machine_id], references: [id])

  menu_id String?
  menu    Menu?   @relation(fields: [menu_id], references: [id])

  consultation_id String?
  consultation    ConsultationHistory? @relation(fields: [consultation_id], references: [id])
}
